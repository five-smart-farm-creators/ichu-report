@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
title Domain Layer — Subscription Plans

class DeviceLimit <<Value Object>> {
  +Maximum : int
  --
  +Allows(used) : bool
  +Covers(headCount) : bool
}
enum FeatureCode {
  Monitoring
  Alerts
  Planning
  Analytics
  ReportExport
}
class HeadCount <<Value Object>> {
  +Value : int
  --
  +Create(value) : Result<HeadCount>
}
class Money <<Value Object>> {
  +Amount : decimal
  +Currency : string
  --
  +Add(other) : Money
  +Multiply(units) : Money
  +ToMinorUnits() : long
}
class PaymentConfirmation <<Value Object>> {
}
class Plan <<Aggregate Root>> {
  +Id : PlanId
  +Tier : PlanTier
  +Name : string
  +DeviceLimit : DeviceLimit
  +AnnualFee : Money
  +DeviceUnitPrice : Money
  +IsPublished : bool
  +Features : FeatureCode[*]
  --
  +EstimateFor(headCount) : Result<PlanQuote>
  +Includes(feature) : bool
}
class PlanId <<Value Object>> {
  +Value : Guid
}
class PlanQuote <<Value Object>> {
}
enum PlanTier {
  Basic
  Standard
  Pro
}
class Subscription <<Aggregate Root>> {
  +Id : SubscriptionId
  +RanchId : Guid
  +PlanId : PlanId
  +HeadCount : HeadCount
  +AnnualFee : Money
  +DevicesCost : Money
  +DeviceUnitPrice : Money
  +Total : Money
  ...
  --
  +Request(ranchId, quote, termsVersion, operationId, acquisitionSource, requestedAt) : Subscription
  +Activate(activatedAt) : Result
  +Cancel(reason, cancelledAt) : Result
  +IsActiveAt(instant) : bool
  +Matches(command) : bool
}
class SubscriptionId <<Value Object>> {
  +Value : Guid
}
enum SubscriptionStatus {
  Pending
  Active
  Cancelled
  Expired
}

Plan --> "0..*" FeatureCode
Plan --> "1" DeviceLimit
Plan --> "1" Money
Plan --> "1" PlanId
Plan --> "1" PlanTier
Subscription --> "1" HeadCount
Subscription --> "1" Money
Subscription --> "1" PlanId
Subscription --> "1" SubscriptionId
Subscription --> "1" SubscriptionStatus
@enduml
