@startuml
!pragma layout smetana
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}
title Esquema planning — Planning

entity "application_records" as application_records {
  * id : uuid <<PK>>
  activity_id : uuid
  applied_at : timestamptz
  cattle_id : uuid
  intervention_id : uuid NULL
}
entity "campaigns" as campaigns {
  * id : uuid <<PK>>
  ends_on : date
  kind : varchar(20)
  name : text
  ranch_id : uuid
  starts_on : date
}
entity "follow_ups" as follow_ups {
  * id : uuid <<PK>>
  activity_id : uuid
  due_at : timestamptz
}
entity "nutrition_plan_items" as nutrition_plan_items {
  * id : bigint <<PK>>
  Id : long
  feed : varchar(80)
  kilograms_per_head_per_day : numeric(7,3)
  kind : varchar(20)
  nutrition_plan_id : uuid
}
entity "nutrition_plans" as nutrition_plans {
  * id : uuid <<PK>>
  lot_id : uuid
  name : varchar(80)
  notes : varchar(500) NULL
  ranch_id : uuid
  target_daily_gain_kilograms : numeric(5,3) NULL
  valid_from : date
  valid_to : date NULL
}
entity "planned_activities" as planned_activities {
  * id : uuid <<PK>>
  campaign_id : uuid NULL
  cattle_id : uuid NULL
  ranch_id : uuid
  scheduled_at : timestamptz
  title : text
}
entity "withdrawal_periods" as withdrawal_periods {
  * id : uuid <<PK>>
  cattle_id : uuid
  ends_at : timestamptz
  intervention_id : uuid NULL
  ranch_id : uuid
  starts_at : timestamptz
}

campaigns ||--o{ planned_activities : campaign_id
planned_activities ||--o{ application_records : activity_id
planned_activities ||--o{ follow_ups : activity_id
nutrition_plans ||--o{ nutrition_plan_items
@enduml
