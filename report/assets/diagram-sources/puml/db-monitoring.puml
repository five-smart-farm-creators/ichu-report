@startuml
!pragma layout smetana
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}
title Esquema monitoring — Operations & Monitoring

entity "AlertChanges" as AlertChanges {
  * OperationId : uuid <<PK>>
  AlertId : uuid
  AppliedAt : timestamptz
  Kind : varchar(32)
  OperationData : text
}
entity "AlertEvidence" as AlertEvidence {
  * AlertId : uuid <<PK>>
  * DeviceId : uuid <<PK>>
  * ReadingId : uuid <<PK>>
}
entity "GeofenceVertices" as GeofenceVertices {
  * Id : bigint <<PK>>
  GeofenceId : uuid
  Latitude : double precision
  Longitude : double precision
  Sequence : integer
  .. UNIQUE (GeofenceId, Sequence) ..
}
entity "Geofences" as Geofences {
  * Id : uuid <<PK>>
  LotId : uuid
  Name : varchar(80)
  RanchId : uuid
  Revision : bigint
  Severity : varchar(32)
  ToleranceMeters : integer
  .. UNIQUE (RanchId, LotId) ..
}
entity "LivestockOperations" as LivestockOperations {
  * Id : uuid <<PK>>
  AuthorId : uuid
  CattleId : uuid
  Dose : varchar(60) NULL
  Observation : varchar(500) NULL
  OccurredAt : timestamptz
  Product : varchar(120) NULL
  RanchId : uuid
  ReceivedAt : timestamptz
  Reproductive_ExpectedCalvingDate : date NULL
  Reproductive_PregnancyResult : varchar(20) NULL
  Reproductive_SireReference : varchar(80) NULL
  Type : varchar(32)
}
entity "MonitoringAlerts" as MonitoringAlerts {
  * Id : uuid <<PK>>
  AcknowledgedAt : timestamptz NULL
  AcknowledgedBy : uuid NULL
  Action : varchar(400) NULL
  CattleId : uuid
  ClearedAt : timestamptz NULL
  ConfigurationRevision : bigint
  DetectedValue : double precision NULL
  DeviceId : uuid
  DistanceToBoundaryMeters : double precision NULL
  Finding : varchar(400) NULL
  GatewayId : uuid
  GeofenceId : uuid NULL
  Latitude : double precision NULL
  Longitude : double precision NULL
  RaisedAt : timestamptz
  RanchId : uuid
  ReceivedAt : timestamptz
  Severity : varchar(32)
  Status : varchar(32)
  ThresholdMaxValue : double precision NULL
  ThresholdMinValue : double precision NULL
  TriggerReadingId : uuid
  Type : varchar(32)
  Version : integer
}
entity "MonitoringRuleSets" as MonitoringRuleSets {
  * RanchId : uuid <<PK>>
  Revision : bigint
}
entity "MonitoringThresholds" as MonitoringThresholds {
  * Id : uuid <<PK>>
  LifeStage : varchar(40)
  Metric : varchar(32)
  RanchId : uuid
  Range_MaxValue : double precision
  Range_MinValue : double precision
  Revision : bigint
  Severity : varchar(32)
  .. UNIQUE (RanchId, LifeStage, Metric, Severity) ..
}
entity "TelemetryReadings" as TelemetryReadings {
  * Id : uuid <<PK>>
  ActivityIndex_InvalidReason : varchar(200) NULL
  ActivityIndex_Value : double precision NULL
  BatteryPercent_InvalidReason : varchar(200) NULL
  BatteryPercent_Value : double precision NULL
  BodyTemperature_InvalidReason : varchar(200) NULL
  BodyTemperature_Value : double precision NULL
  CattleId : uuid NULL
  DeviceId : uuid
  GatewayId : uuid
  HeartRate_InvalidReason : varchar(200) NULL
  HeartRate_Value : double precision NULL
  MethaneIndex_InvalidReason : varchar(200) NULL
  MethaneIndex_Value : double precision NULL
  Position_AccuracyMeters : double precision NULL
  Position_InvalidReason : varchar(200) NULL
  Position_Latitude : double precision NULL
  Position_Longitude : double precision NULL
  RanchId : uuid
  ReadingId : uuid
  ReceivedAt : timestamptz
  RecordedAt : timestamptz
  RuminationMinutes_InvalidReason : varchar(200) NULL
  RuminationMinutes_Value : double precision NULL
  .. UNIQUE (DeviceId, ReadingId) ..
}
entity "WaterTroughReadings" as WaterTroughReadings {
  * Id : uuid <<PK>>
  CapturedAt : timestamptz
  ControllerId : uuid
  CreatedAt : timestamptz NULL
  GatewayId : uuid
  HeaterState : varchar(32)
  IsValid : boolean
  Origin : varchar(32)
  RanchId : uuid
  ReadingId : uuid
  ReceivedAt : timestamptz
  Temperature : numeric
  TemperatureUnit : varchar(32)
  UpdatedAt : timestamptz NULL
  WaterTroughId : uuid
  .. UNIQUE (ControllerId, ReadingId) ..
}

MonitoringAlerts ||--o{ AlertChanges
MonitoringAlerts ||--o{ AlertEvidence
Geofences ||--o{ GeofenceVertices
@enduml
