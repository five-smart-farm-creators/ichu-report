@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
title Domain Layer — Planning

class ApplicationRecord <<Entity>> {
  +Id : ApplicationRecordId
  +ActivityId : PlannedActivityId
  +CattleId : Guid
  +AppliedAt : DateTimeOffset
  +InterventionId : Guid
}
class ApplicationRecordId <<Value Object>> {
  +Value : Guid
}
enum CampaignKind {
  Sanitary
  Reproductive
}
class FollowUp <<Entity>> {
  +Id : FollowUpId
  +ActivityId : PlannedActivityId
  +DueAt : DateTimeOffset
}
class FollowUpId <<Value Object>> {
  +Value : Guid
}
class NutritionPlan <<Aggregate Root>> {
  +Id : NutritionPlanId
  +RanchId : Guid
  +LotId : Guid
  +Name : string
  +ValidFrom : DateOnly
  +ValidTo : DateOnly
  +Items : RationItem[*]
  +TargetDailyGainKilograms : decimal
  ...
  --
  +Create(command) : Result<NutritionPlan>
  +Overlaps(from, to) : bool
  +CloseBefore(day) : Result
}
class NutritionPlanId <<Value Object>> {
  +Value : Guid
}
class PlannedActivity <<Aggregate Root>> {
  +Id : PlannedActivityId
  +RanchId : Guid
  +CampaignId : PlanningCampaignId
  +CattleId : Guid
  +Title : string
  +ScheduledAt : DateTimeOffset
  +Applications : ApplicationRecord[*]
  +FollowUps : FollowUp[*]
  --
  +Create(ranchId, campaignId, cattleId, title, scheduledAt) : Result<PlannedActivity>
  +RecordApplication(cattleId, appliedAt, interventionId) : Result<ApplicationRecord>
  +ScheduleFollowUp(dueAt) : Result<FollowUp>
}
class PlannedActivityId <<Value Object>> {
  +Value : Guid
}
class PlanningCampaign <<Aggregate Root>> {
  +Id : PlanningCampaignId
  +RanchId : Guid
  +Name : string
  +Kind : CampaignKind
  +StartsOn : DateOnly
  +EndsOn : DateOnly
  --
  +Create(ranchId, name, kind, startsOn, endsOn) : Result<PlanningCampaign>
}
class PlanningCampaignId <<Value Object>> {
  +Value : Guid
}
class RationItem <<Value Object>> {
  +Feed : string
  +Kind : RationKind
  +KilogramsPerHeadPerDay : decimal
  --
  +Create(feed, kind, kilogramsPerHeadPerDay) : Result<RationItem>
}
enum RationKind {
  Forage
  Concentrate
  Supplement
  Mineral
}
class WithdrawalPeriod <<Aggregate Root>> {
  +Id : WithdrawalPeriodId
  +RanchId : Guid
  +CattleId : Guid
  +InterventionId : Guid
  +StartsAt : DateTimeOffset
  +EndsAt : DateTimeOffset
  --
  +Create(ranchId, cattleId, interventionId, startsAt, endsAt) : Result<WithdrawalPeriod>
}
class WithdrawalPeriodId <<Value Object>> {
  +Value : Guid
}

ApplicationRecord --> "1" ApplicationRecordId
ApplicationRecord --> "1" PlannedActivityId
FollowUp --> "1" FollowUpId
FollowUp --> "1" PlannedActivityId
NutritionPlan --> "0..*" RationItem
NutritionPlan --> "1" NutritionPlanId
PlannedActivity *-- "0..*" ApplicationRecord
PlannedActivity *-- "0..*" FollowUp
PlannedActivity --> "1" PlannedActivityId
PlannedActivity --> "1" PlanningCampaignId
PlanningCampaign --> "1" CampaignKind
PlanningCampaign --> "1" PlanningCampaignId
RationItem --> "1" RationKind
WithdrawalPeriod --> "1" WithdrawalPeriodId
@enduml
