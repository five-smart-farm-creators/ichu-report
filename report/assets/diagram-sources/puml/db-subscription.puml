@startuml
!pragma layout smetana
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}
title Esquema subscription — Subscription Plans

entity "plans" as plans {
  * PlanId : uuid <<PK>>
  id : uuid
  annual_fee_amount : numeric(12,2)
  annual_fee_currency : character(3)
  device_limit : integer
  device_unit_price_amount : numeric(12,2)
  device_unit_price_currency : character(3)
  is_published : boolean
  name : varchar(40)
  tier : varchar(32)
}
entity "subscriptions" as subscriptions {
  * SubscriptionId : uuid <<PK>>
  id : uuid
  acquisition_source : varchar(64) NULL
  activated_at : timestamptz NULL
  annual_fee_amount : numeric(12,2)
  annual_fee_currency : character(3)
  cancellation_reason : varchar(200) NULL
  cancelled_at : timestamptz NULL
  devices_cost_amount : numeric(12,2)
  devices_cost_currency : character(3)
  head_count : integer
  operation_id : uuid <<UQ>>
  plan_id : uuid
  ranch_id : uuid <<UQ>>
  requested_at : timestamptz
  status : varchar(32)
  terms_version : varchar(16)
  total_amount : numeric(12,2)
  total_currency : character(3)
  valid_until : timestamptz NULL
}

@enduml
