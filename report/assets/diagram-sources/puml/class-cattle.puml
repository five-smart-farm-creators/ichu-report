@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
title Domain Layer — Cattle Information

enum Breed {
  BrownSwiss
  Fleckvieh
  Criollo
  Crossbred
}
class Cattle <<Aggregate Root>> {
  +Id : CattleId
  +RanchId : Guid
  +EarTag : EarTag
  +Breed : Breed
  +Sex : Sex
  +BirthDate : DateOnly
  +Status : CattleStatus
  +CurrentStage : LifeStage
  ...
  --
  +Register(command, today) : Result<Cattle>
  +Update(command, today) : Result
  +ChangeStage(command, today) : Result
  +Patch(command, today) : Result
  +Deactivate(command, today, recordedAt) : Result
}
class CattleId <<Value Object>> {
  +Value : Guid
}
enum CattleStatus {
  Active
  Inactive
}
class EarTag <<Value Object>> {
  +Value : string
  --
  +Create(value) : Result<EarTag>
}
enum ExitReason {
  Death
  Sale
  Theft
  Culling
}
enum LifeStage {
  Calf
  Heifer
  MilkingCow
  FatteningBull
}
class Lot <<Aggregate Root>> {
  +Id : LotId
  +RanchId : Guid
  +Name : string
  +Criterion : string
  +Version : Guid
  +Memberships : LotMembership[*]
  --
  +Create(command) : Result<Lot>
  +AddCattle(cattle, expectedVersion, assignedAt) : Result
  +RemoveCattle(cattleId, expectedVersion) : Result
}
class LotId <<Value Object>> {
  +Value : Guid
}
class LotMembership <<Entity>> {
  +LotId : LotId
  +RanchId : Guid
  +CattleId : CattleId
  +AssignedAt : DateTimeOffset
}
enum Sex {
  Female
  Male
}
class StagePeriod <<Entity>> {
  +Id : Guid
  +CattleId : CattleId
  +LifeStage : LifeStage
  +ValidFrom : DateOnly
  +ValidTo : DateOnly
}

Cattle *-- "0..*" StagePeriod
Cattle --> "1" Breed
Cattle --> "1" CattleId
Cattle --> "1" CattleStatus
Cattle --> "1" EarTag
Cattle --> "1" ExitReason
Cattle --> "1" LifeStage
Cattle --> "1" Sex
Lot *-- "0..*" LotMembership
Lot --> "1" LotId
LotMembership --> "1" CattleId
LotMembership --> "1" LotId
StagePeriod --> "1" CattleId
StagePeriod --> "1" LifeStage
@enduml
