@startuml
!pragma layout smetana
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}
title Esquema iam — Identity & Access Management

entity "AccessAttempts" as AccessAttempts {
  * Id : uuid <<PK>>
  RecordedAt : timestamptz
  Succeeded : boolean
  UserAccountId : uuid
}
entity "HerdAdvisories" as HerdAdvisories {
  * Id : uuid <<PK>>
  DecidedBy : uuid NULL
  EndedAt : timestamptz NULL
  ExpiresAt : timestamptz NULL
  GrantedAt : timestamptz NULL
  RanchId : uuid
  Reason : varchar(1000)
  RequestedAt : timestamptz
  Revision : uuid
  Scope : varchar(32)
  Status : varchar(32)
  VeterinarianId : uuid
  .. UNIQUE (VeterinarianId, RanchId) ..
}
entity "ProfessionalProfiles" as ProfessionalProfiles {
  * UserAccountId : uuid <<PK>>
  LicenseNumber : varchar(80) <<UQ>>
  Specialty : varchar(120)
  YearsOfExperience : integer
}
entity "RanchMemberships" as RanchMemberships {
  * Id : uuid <<PK>>
  IsOwner : boolean
  RanchId : uuid
  UserAccountId : uuid
  .. UNIQUE (UserAccountId, RanchId) ..
}
entity "RanchRegistrations" as RanchRegistrations {
  * Id : uuid <<PK>>
  AccessCode : varchar(8) <<UQ>>
  District : varchar(120)
  EstimatedHeadCount : integer
  Name : varchar(160)
  Region : varchar(120)
}
entity "UserAccounts" as UserAccounts {
  * Id : uuid <<PK>>
  BlockedUntil : timestamptz NULL
  Email : varchar(254) <<UQ>>
  ExternalUid : varchar(128) <<UQ>>
  FailedAttempts : integer
  LastFailedAt : timestamptz NULL
  RegisteredAt : timestamptz
  Revision : uuid
  Role : varchar(32)
  Status : varchar(32)
}

RanchRegistrations ||--o{ HerdAdvisories : RanchId
UserAccounts ||--o{ HerdAdvisories : VeterinarianId
UserAccounts ||--o{ AccessAttempts : UserAccountId
RanchRegistrations ||--o{ RanchMemberships : RanchId
UserAccounts ||--o{ RanchMemberships : UserAccountId
UserAccounts ||--o{ ProfessionalProfiles
@enduml
