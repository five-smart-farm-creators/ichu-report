@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
title Domain Layer — Identity & Access Management

class AccessAttempt <<Entity>> {
  +Id : Guid
  +UserAccountId : UserAccountId
  +RecordedAt : DateTimeOffset
  +Succeeded : bool
  --
  +Create(userAccountId, recordedAt, succeeded) : Result<AccessAttempt>
}
enum AccessScope {
  Read
  ClinicalWrite
  Manage
}
enum AccountStatus {
  PendingVerification
  Active
  TemporarilyBlocked
}
enum AdvisoryStatus {
  Pending
  Granted
  Rejected
  Revoked
  Expired
}
class Email <<Value Object>> {
  +Value : string
  --
  +Create(value) : Result<Email>
}
class HerdAdvisory <<Aggregate Root>> {
  +Id : HerdAdvisoryId
  +VeterinarianId : UserAccountId
  +RanchId : Guid
  +Reason : string
  +Status : AdvisoryStatus
  +Scope : AccessScope
  +RequestedAt : DateTimeOffset
  +GrantedAt : DateTimeOffset
  ...
  --
  +Create(veterinarianId, ranchId, reason, now) : Result<HerdAdvisory>
  +IsValidOn(now) : bool
  +Grant(actorId, scope, expiresAt, now) : Result
  +End(actorId, reject, now) : Result
  +Expire(now) : void
}
class HerdAdvisoryId <<Value Object>> {
  +Value : Guid
}
class ProfessionalProfile <<Entity>> {
  +Specialty : string
  +LicenseNumber : string
  +YearsOfExperience : int
  --
  +Create(specialty, licenseNumber, yearsOfExperience) : Result<ProfessionalProfile>
}
class RanchAccessCode <<Value Object>> {
  +Value : string
  --
  +Create(value) : Result<RanchAccessCode>
}
class RanchMembership <<Entity>> {
  +Id : Guid
  +UserAccountId : UserAccountId
  +RanchId : Guid
  +IsOwner : bool
  --
  +Create(userAccountId, ranchId, isOwner) : Result<RanchMembership>
}
class RanchRegistration <<Aggregate Root>> {
  +Id : Guid
  +Name : string
  +Region : string
  +District : string
  +EstimatedHeadCount : int
  +AccessCode : RanchAccessCode
  --
  +Create(name, region, district, estimatedHeadCount, accessCode) : Result<RanchRegistration>
}
class UserAccount <<Aggregate Root>> {
  +Id : UserAccountId
  +ExternalUid : string
  +Email : Email
  +Role : UserRole
  +Status : AccountStatus
  +Profile : ProfessionalProfile
  +RegisteredAt : DateTimeOffset
  +BlockedUntil : DateTimeOffset
  ...
  --
  +Create(externalUid, email, role, now) : Result<UserAccount>
  +IsActive(now) : bool
  +IsBlocked(now) : bool
  +Verify() : void
  +RecordFailedAttempt(now) : void
  +RecordSuccessfulAccess(now) : Result
  ...
}
class UserAccountId <<Value Object>> {
  +Value : Guid
}
enum UserRole {
  RanchManager
  FieldOperator
  Veterinarian
}

AccessAttempt --> "1" UserAccountId
HerdAdvisory --> "1" AccessScope
HerdAdvisory --> "1" AdvisoryStatus
HerdAdvisory --> "1" HerdAdvisoryId
HerdAdvisory --> "1" UserAccountId
RanchMembership --> "1" UserAccountId
RanchRegistration --> "1" RanchAccessCode
UserAccount *-- "1" ProfessionalProfile
UserAccount --> "1" AccountStatus
UserAccount --> "1" Email
UserAccount --> "1" UserAccountId
UserAccount --> "1" UserRole
@enduml
