@startuml
!pragma layout smetana
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members
title Domain Layer — IoT Assets

enum AssignmentTargetType {
  Cattle
  WaterTrough
}
class BatteryLevel <<Value Object>> {
  +Percentage : int
  --
  +Create(percentage) : Result<BatteryLevel>
  +IsLow(threshold) : bool
}
enum CommunicationStatus {
  NeverReported
  Communicating
  NoCommunication
}
class DeviceAssignment <<Entity>> {
  +Id : DeviceAssignmentId
  +DeviceId : DeviceId
  +RanchId : Guid
  +TargetId : Guid
  +TargetType : AssignmentTargetType
  +StartedAt : DateTimeOffset
  +EndedAt : DateTimeOffset
  +ReleaseReason : string
  --
  +IsOpen() : bool
  +CoversInstant(instant) : bool
}
class DeviceAssignmentId <<Value Object>> {
  +Value : Guid
}
class DeviceId <<Value Object>> {
  +Value : Guid
}
class DeviceSerial <<Value Object>> {
  +Value : string
  --
  +Create(value) : Result<DeviceSerial>
}
enum DeviceStatus {
  Available
  InService
  Maintenance
}
enum DeviceType {
  SmartCollar
  WaterController
}
class EdgeGateway <<Aggregate Root>> {
  +Id : EdgeGatewayId
  +RanchId : Guid
  +Name : string
  +KeyHash : GatewayKeyHash
  +Status : EdgeGatewayStatus
  +RegisteredAt : DateTimeOffset
  +RevokedAt : DateTimeOffset
  +Version : Guid
  --
  +Register(command, keyHash, registeredAt) : Result<EdgeGateway>
  +Revoke(at) : Result
  +Authenticates(secret) : bool
}
class EdgeGatewayId <<Value Object>> {
  +Value : Guid
}
enum EdgeGatewayStatus {
  Active
  Revoked
}
class GatewayKeyHash <<Value Object>> {
  --
  +Of(secret) : GatewayKeyHash
  +Matches(secret) : bool
  +ToBytes() : byte[]
}
class IoTDevice <<Aggregate Root>> {
  +CreatedAt : DateTimeOffset
  +UpdatedAt : DateTimeOffset
}
class TemperatureRange <<Value Object>> {
  +MinimumCelsius : decimal
  +MaximumCelsius : decimal
  --
  +Create(minimumCelsius, maximumCelsius) : Result<TemperatureRange>
}
class WaterTrough <<Aggregate Root>> {
  +CreatedAt : DateTimeOffset
  +UpdatedAt : DateTimeOffset
}
class WaterTroughId <<Value Object>> {
  +Value : Guid
}

DeviceAssignment --> "1" AssignmentTargetType
DeviceAssignment --> "1" DeviceAssignmentId
DeviceAssignment --> "1" DeviceId
EdgeGateway --> "1" EdgeGatewayId
EdgeGateway --> "1" EdgeGatewayStatus
EdgeGateway --> "1" GatewayKeyHash
@enduml
