@startuml
!pragma layout smetana
skinparam shadowing false
skinparam linetype ortho
hide circle
hide methods
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}
title Esquema cattle — Cattle Information

entity "cattle" as cattle {
  * id : uuid <<PK>>
  birth_date : date
  breed : varchar(30)
  current_stage : varchar(20)
  ear_tag : varchar(30)
  exit_date : date NULL
  exit_reason : varchar(15) NULL
  ranch_id : uuid
  sex : varchar(10)
  status : varchar(12)
  version : uuid
  .. UNIQUE (ranch_id, ear_tag) ..
}
entity "lot_memberships" as lot_memberships {
  * cattle_id : uuid <<PK>>
  * lot_id : uuid <<PK>>
  assigned_at : timestamptz
  ranch_id : uuid
}
entity "lots" as lots {
  * id : uuid <<PK>>
  criterion : varchar(120) NULL
  name : varchar(80)
  ranch_id : uuid
  version : uuid
}
entity "stage_periods" as stage_periods {
  * id : uuid <<PK>>
  cattle_id : uuid
  life_stage : varchar(20)
  valid_from : date
  valid_to : date NULL
}

cattle ||--o{ lot_memberships : ranch_id, cattle_id
lots ||--o{ lot_memberships : ranch_id, lot_id
cattle ||--o{ stage_periods : cattle_id
@enduml
